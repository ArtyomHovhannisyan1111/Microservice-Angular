  "PRODUCTS": {
    "DESC_52": "Փորձնական ապրանք պատկերների բեռնման սխալները ստուգելու համար",
    "DESC_76": "Android պլանշետ 11 դյույմ 144Հց էկրանով, Snapdragon 8 Gen 1 պրոցեսորով և Smart Pen ստիլուսի աջակցությամբ",
    "DESC_77": "Գեյմինգ նոութբուք AMD Ryzen 5 7535HS պրոցեսորով, RTX 4060 տեսաքարտով և 16 դյույմ IPS 144Հց էկրանով",
    "DESC_78": "Ծալովի քվադրոկոպտեր 4K/60fps տեսախցիկով, մինչև 34 րոպե թռիչքի և խոչընդոտներից խուսափելու հնարավորությամբ",
    "DESC_79": "Էլեկտրոնային գիրք 6,8 դյույմ էկրանով, IPX8 պաշտպանությամբ և կարգավորվող լուսավորությամբ",
    "DESC_80": "Մեխանիկական գեյմինգ ստեղնաշար Cherry MX Speed Silver անջատիչներով, RGB լուսավորությամբ և մեդիա ստեղներով",
    "DESC_81": "Անլար գեյմինգ մկնիկ Hero 25K սենսորով, մինչև 60 ժամ աշխատանքով և 61 գրամ քաշով",
    "DESC_82": "Գեյմինգ ականջակալ 7.1 վիրտուալ ձայնով, հանվող խոսափողով և ձայնի կարգավորման կոճակով",
    "DESC_83": "Ստուդիական USB խոսափող ձայնագրման չորս ռեժիմով՝ կարդիոիդ, ստերեո, ամնիդիրեկցիոնալ, երկկողմանի",
    "DESC_84": "Մասնագիտական 4K մոնիտոր 100% sRGB գամմայով, USB-C 90 Վատտ հզորությամբ և VESA DisplayHDR 400 հավաստագրով",
    "DESC_85": "Գեյմինգ մոնիտոր IPS QHD 2560×1440 մատրիցայով, 165Հց թարմացման հաճախականությամբ և 0,5 մվ արձագանքման ժամանակով",
    "DESC_86": "Մոնիտոր քվանտային կետերով Rapid IPS, 97% DCI-P3 գամմայով և AMD FreeSync Premium Pro-ով",
    "DESC_87": "Կոր VA FHD 240Հց մոնիտոր 0,5 մվ արձագանքման ժամանակով և AOC Shadow Control տեխնոլոգիայով",
    "DESC_88": "Անլար ականջակալներ ակտիվ աղմկահանման համակարգով, մինչև 60 ժամ աշխատանքով և aptX Adaptive կոդեկով",
    "DESC_89": "Մասնագիտական ստուդիական ականջակալներ փակ կոնստրուկցիայով, շարժական մալուխներով և ընդլայնված հաճախային տիրույթով",
    "DESC_90": "Կոմպակտ սեղանի բարձրախոսներ USB-C աուդիոյով, Bluetooth 5.0 և 8 Վատտ հզորությամբ առանց լրացուցիչ սնուցման",
    "DESC_91": "Գրասենյակային ակտիվ բարձրախոսներ Bluetooth 5.0-ով, ներկառուցված 24-bit ՑԱՓ-ով և կառավարման վահանակով",
    "DESC_92": "Կոմպակտ անլար ստեղնաշար հետին լուսավորությամբ, մինչև 3 սարքի միացման և մինչև 10 ամիս աշխատանքի հնարավորությամբ",
    "DESC_93": "3-ը-1-ում MagSafe լիցքավորիչ iPhone, Apple Watch և AirPods միաժամանակ լիցքավորման համար",
    "DESC_94": "Ծրագրավորվող սթրիմ-կառավարիչ 15 LCD ստեղներով, սթրիմինգ ծառայությունների ինտեգրացիայով և մագնիսական հիմքով",
    "DESC_95": "Կոմպակտ 100 Վատտ GaN լիցքավորիչ՝ երեք USB-C և մեկ USB-A պորտերով՝ մի քանի սարքի միաժամանակ լիցքավորման համար"
  },
